/* 外层可滚动页面 */
.page-scroll {
  height: 100vh;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.card-info {
  font-size: 24rpx;
  color: #999999;
  background: #F6F6F6;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 图纸卡片 */
.grid-card {
  /* 无额外约束，自然布局 */
}

/* 缩放控制 */
.zoom-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  gap: 24rpx;
}

.zoom-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: #F6F6F6;
  border-radius: 50%;
  font-size: 36rpx;
  color: #333333;
  font-weight: 500;
}

.zoom-btn:active {
  background: #D6E8FF;
  color: #1677FF;
}

.zoom-btn.zoom-disabled {
  color: #CCCCCC;
  pointer-events: none;
}

.zoom-label {
  font-size: 28rpx;
  color: #666666;
  min-width: 80rpx;
  text-align: center;
  font-weight: 500;
}

/* Canvas 滚动容器——固定高度，不外溢 */
.canvas-scroll {
  width: 100%;
  height: 520rpx;
  border-radius: 12rpx;
  background: #FAFAFA;
  border: 1rpx solid #EEEEEE;
}

/* 统计卡片 */
.stats-card {
  margin-bottom: 24rpx;
}

/* 统计列表滚动容器 */
.stats-scroll {
  max-height: 500rpx;
}

/* 色卡列表 */
.color-grid {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.color-card {
  display: flex;
  align-items: center;
  padding: 12rpx 12rpx;
  border-radius: 12rpx;
  background: #FAFAFA;
  gap: 16rpx;
}

.color-swatch {
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.color-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.color-code {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.color-name {
  font-size: 22rpx;
  color: #999999;
}

.color-count {
  font-size: 26rpx;
  color: #1677FF;
  font-weight: 500;
  text-align: right;
  min-width: 80rpx;
}

/* 总计栏 */
.total-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #F0F7FF 0%, #F5FAFF 100%);
  border-radius: 12rpx;
  border: 2rpx solid #69B1FF;
}

.total-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.total-num {
  font-size: 32rpx;
  color: #1677FF;
  font-weight: 700;
}

/* 底部操作栏（固定） */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-primary {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #1677FF 0%, #69B1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 86rpx;
  text-align: center;
  background: #FFFFFF;
  color: #1677FF;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: 2rpx solid #1677FF;
}

.btn-secondary:active {
  background: #F0F7FF;
}

.render-canvas {
  position: fixed;
  left: -10000px;
  top: 0;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

.edit-actions { display:flex; flex-wrap:wrap; gap:16rpx; margin-bottom:24rpx; }
.edit-actions button { background:#F0F3F7; border-radius:12rpx; padding:8rpx 18rpx; font-size:24rpx; }
.edit-hint { color:#777; font-size:24rpx; margin:20rpx 0; }
.edit-swatches { display:flex; flex-wrap:wrap; gap:16rpx; }
.edit-swatch { width:110rpx; text-align:center; font-size:22rpx; padding:8rpx; background:#F7F8FA; border-radius:12rpx; }
.edit-chip { width:44rpx; height:44rpx; border:1rpx solid #DDD; border-radius:8rpx; margin:0 auto 8rpx; }
.palette-scroll { height:300rpx; margin:20rpx 0; }

.export-panel { background:#FBF7EF; }
.export-options { display:flex; flex-wrap:wrap; gap:12rpx; }
.export-options .option { flex:1; min-width:140rpx; padding:14rpx 12rpx; font-size:24rpx; background:#FFFDF8; color:#63594D; border:1rpx solid #E6DCCC; border-radius:12rpx; }
.export-options .selected { background:#242321; color:#FFF; border-color:#242321; }

.edit-actions { display:grid; grid-template-columns:repeat(3,1fr); }
.edit-actions button { width:100%; box-sizing:border-box; }
.canvas-scroll { box-sizing:border-box; }
.modal-mask { position:fixed; inset:0; z-index:500; background:rgba(25,25,28,.48); display:flex; align-items:flex-end; }
.modal-sheet { width:100%; max-height:90vh; background:#FFFCF6; border-radius:32rpx 32rpx 0 0; overflow:hidden; padding-bottom:env(safe-area-inset-bottom); }
.modal-header { display:flex; justify-content:space-between; align-items:center; padding:28rpx 32rpx; font-size:34rpx; font-weight:600; border-bottom:1rpx solid #E9E2D8; }
.modal-header button { font-size:26rpx; color:#766B5E; margin:0; }
.modal-body { height:62vh; box-sizing:border-box; padding:24rpx; }
.modal-footer { display:flex; gap:20rpx; padding:24rpx; }
.export-sample { background:white; border:1rpx solid #E9E2D8; border-radius:20rpx; overflow:hidden; text-align:center; padding-bottom:20rpx; }
.export-sample image { display:block; width:100%; }
.export-sample text { font-size:22rpx; color:#85796A; }
.modal-body .card { margin:16rpx 0; padding:20rpx; box-shadow:none; }
.modal-body input { background:white; padding:20rpx; border-radius:12rpx; }
