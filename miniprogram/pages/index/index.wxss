.page {
  padding-bottom: 140rpx;
  min-height: 100vh;
}

/* 顶部标题区 */
.header {
  text-align: center;
  padding: 60rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #1677FF 0%, #69B1FF 100%);
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* 上传区域 */
.upload-area {
  border: 3rpx dashed #69B1FF;
  border-radius: 16rpx;
  background: #F0F7FF;
  padding: 60rpx 32rpx;
  text-align: center;
}

.upload-area:active {
  background: #D6E8FF;
  border-color: #1677FF;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 76rpx;
  border-radius: 50%;
  border: 4rpx solid #1677FF;
  color: #1677FF;
  font-size: 48rpx;
  font-weight: 300;
  margin: 0 auto 20rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.upload-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 图片预览 */
.preview-area {
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F5F5F5;
}

.preview-image {
  width: 100%;
  height: 400rpx;
}

.preview-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 24rpx;
}

/* 尺寸设置 */
.size-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.size-item {
  flex: 1;
  text-align: center;
}

.size-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

/* 加减微调按钮行 */
.stepper-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #F0F7FF;
  border: 2rpx solid #D6E8FF;
  border-radius: 50%;
  font-size: 32rpx;
  color: #1677FF;
  font-weight: 600;
}

.step-btn:active {
  background: #1677FF;
  color: #FFFFFF;
}

.size-input {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #F6F6F6;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.size-input.size-locked {
  background: #F0F7FF;
  border: 2rpx solid #69B1FF;
}

.size-sep {
  font-size: 40rpx;
  color: #CCCCCC;
  margin: 0 24rpx;
  padding-top: 24rpx;
  font-weight: 300;
}

/* 快捷尺寸标签 */
.presets-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

/* 快捷尺寸 */
.presets {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.preset {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  background: #F6F6F6;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666666;
}

.preset:active {
  background: #D6E8FF;
}

.preset.active {
  background: #F0F7FF;
  color: #1677FF;
  font-weight: 600;
  border: 2rpx solid #1677FF;
}

/* 锁定比例 */
.lock-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0F0F0;
}

.lock-label {
  font-size: 28rpx;
  color: #666666;
}

/* 底部生成按钮 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.generate-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  background: linear-gradient(135deg, #1677FF 0%, #69B1FF 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 2rpx;
}

.generate-btn:active {
  opacity: 0.85;
}

.generate-btn[disabled] {
  background: #E0E0E0;
  color: #999999;
  box-shadow: none;
}

.generate-btn.btn-loading {
  opacity: 0.8;
}

.presets { flex-wrap: wrap; }
.preset { min-width: 100rpx; }
